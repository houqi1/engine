#version 450
#extension GL_GOOGLE_include_directive : require

#include "dir_mask_lut.glsl"

// Standalone coarse-grid DDA. No brick/fine/AO functions in this module.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform VoxelDdaUBO {
    mat4 invView;
    mat4 invProj;
    vec3 cameraPos;
    float _pad0;
    vec3 lightDir;
    float ambient;
    float projX;
    float projY;
    uint maxSteps;
    uint renderMode;
    vec3 skyColor;
    uint traceStage;
    float aoStrength;
    float aoPower;
    float skyYaw;
    float skyIntensity;
    uint useSky;
    uint objectCount;
    uint solidColor;
    uint dirMaskCoarse;
    uint brickBitSkip;
    uint beamSkip;
    float beamMargin;
    uint dirMaskBrick;
    vec3 solidRgb;
    float _padSolidEnd;
} ubo;

layout(set = 0, binding = 1) uniform usampler3D grids[2];
layout(set = 0, binding = 2, rgba8) writeonly uniform image2D outImage;
layout(set = 0, binding = 4) uniform sampler2D skyMap;

struct GpuVoxelObject {
    mat4 worldToObject;
    mat4 objectToWorld;
    float voxelSize;
    float _pad0;
    float _pad1;
    float _pad2;
    uvec3 gridSize;
    uint flags;
    uint voxelOffset;
    uint occMipOffset;
    uint occMipWords;
    uint _pad4;
};

layout(set = 0, binding = 5, std430) readonly buffer ObjectBuffer {
    GpuVoxelObject objects[];
};

layout(set = 0, binding = 6, std430) readonly buffer ImportPalette {
    vec4 importPalette[256];
};

layout(set = 0, binding = 7, std430) readonly buffer OccupancyMip {
    uint occTiles[];
};

const uint FLAG_ENABLED = 2u;
const uint FLAG_IMPORT_PALETTE = 4u;
const uint MODE_SHADED = 0u;
const uint MODE_ALBEDO = 1u;
const uint MODE_NORMAL = 2u;
const uint MODE_STEPS = 3u;
const float FLT_MAX = 3.4028235e+38;
const float kPi = 3.14159265359;
const int MAX_RAY_STEPS = 96;

vec3 sampleSky(vec3 dir) {
    if (ubo.useSky == 0u) {
        return ubo.skyColor;
    }
    float cy = cos(ubo.skyYaw);
    float sy = sin(ubo.skyYaw);
    vec3 rotated = vec3(cy * dir.x + sy * dir.z, dir.y, -sy * dir.x + cy * dir.z);
    float phi = atan(rotated.z, rotated.x);
    float theta = asin(clamp(rotated.y, -1.0, 1.0));
    vec2 uv = vec2(fract(phi / (2.0 * kPi) + 0.5), 0.5 - theta / kPi);
    vec3 hdr = textureLod(skyMap, uv, 0.0).rgb;
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    vec3 x = max(hdr, vec3(0.0)) * ubo.skyIntensity;
    vec3 ldr = clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
    return pow(ldr, vec3(1.0 / 2.2));
}

uint readMaterial(GpuVoxelObject o, ivec3 p) {
    if (o.voxelOffset == 0u) {
        return texelFetch(grids[0], p, 0).x;
    }
    return texelFetch(grids[1], p, 0).x;
}

bvec3 stepMask(vec3 sideDist) {
    return lessThanEqual(sideDist.xyz, min(sideDist.yzx, sideDist.zxy));
}

uint dirOctantFromSgn(vec3 sgn) {
    return (sgn.x < 0.0 ? 1u : 0u) | (sgn.y < 0.0 ? 2u : 0u) | (sgn.z < 0.0 ? 4u : 0u);
}

uvec2 loadCoarseOcc4(GpuVoxelObject o, ivec3 mapPos) {
    if (o.occMipWords == 0u) {
        return uvec2(0xFFFFFFFFu);
    }
    uint tileN = (o.gridSize.x + 3u) >> 2;
    uvec3 t = uvec3(mapPos) >> 2;
    uint tile = t.x + t.y * tileN + t.z * tileN * tileN;
    uint base = o.occMipOffset + tile * 2u;
    return uvec2(occTiles[base], occTiles[base + 1u]);
}

int coarseSkipShift(GpuVoxelObject o, ivec3 mapPos, uint oct) {
    if (ubo.dirMaskCoarse == 0u) {
        return -1;
    }
    uvec2 occ4 = loadCoarseOcc4(o, mapPos);
    if ((occ4.x | occ4.y) == 0u) {
        return 2;
    }
    uvec2 reach = directionReachMask(oct, mapPos);
    if ((occ4.x & reach.x) == 0u && (occ4.y & reach.y) == 0u) {
        return 2;
    }
    return -1;
}

bool jumpAlignedBox(inout ivec3 mapPos, inout vec3 sideDist, inout bvec3 mask, vec3 origin,
                    vec3 rd, vec3 invDir, vec3 sgn, vec3 deltaDist, ivec3 rayStep, int shift,
                    vec3 limit, inout uint steps) {
    ivec3 macro = mapPos >> shift;
    vec3 boxMin = vec3(macro << shift);
    vec3 boxMax = min(boxMin + vec3(float(1 << shift)), limit);
    vec3 t0m = (boxMin - origin) * invDir;
    vec3 t1m = (boxMax - origin) * invDir;
    vec3 tLargerM = max(t0m, t1m);
    float tExitM = min(min(tLargerM.x, tLargerM.y), tLargerM.z);
    bvec3 skipMask;
    if (tLargerM.x <= tLargerM.y && tLargerM.x <= tLargerM.z) {
        skipMask = bvec3(true, false, false);
    } else if (tLargerM.y <= tLargerM.z) {
        skipMask = bvec3(false, true, false);
    } else {
        skipMask = bvec3(false, false, true);
    }
    vec3 newPos = origin + rd * (tExitM + 1e-4);
    ivec3 newMap = ivec3(clamp(floor(newPos), vec3(0.0), max(limit - vec3(1.0), vec3(0.0))));
    steps += 1u;
    if (newMap == mapPos || (newMap >> shift) == macro) {
        mask = stepMask(sideDist);
        sideDist += vec3(mask) * deltaDist;
        mapPos += ivec3(vec3(mask)) * rayStep;
        return true;
    }
    if (any(lessThan(newMap, ivec3(0))) || any(greaterThanEqual(newMap, ivec3(limit)))) {
        return false;
    }
    mapPos = newMap;
    mask = skipMask;
    sideDist = (sgn * (vec3(mapPos) - origin) + (sgn * 0.5 + 0.5)) * deltaDist;
    return true;
}

struct Hit {
    bool hit;
    float tWorld;
    vec3 color;
    vec3 normal;
    uint steps;
};

Hit traceCoarse(GpuVoxelObject o, vec3 Ow, vec3 Dw) {
    Hit result;
    result.hit = false;
    result.tWorld = FLT_MAX;
    result.color = vec3(0.0);
    result.normal = vec3(0.0, 1.0, 0.0);
    result.steps = 0u;
    if ((o.flags & FLAG_ENABLED) == 0u || o.voxelSize <= 0.0) {
        return result;
    }

    vec3 Ol = (o.worldToObject * vec4(Ow, 1.0)).xyz;
    vec3 Dl = (o.worldToObject * vec4(Dw, 0.0)).xyz;
    if (dot(Dl, Dl) < 1e-12) {
        return result;
    }

    vec3 ro = Ol / o.voxelSize;
    vec3 rd = Dl;
    vec3 invDir = clamp(1.0 / rd, vec3(-FLT_MAX), vec3(FLT_MAX));
    vec3 sgn = sign(rd);
    if (sgn.x == 0.0) sgn.x = 1.0;
    if (sgn.y == 0.0) sgn.y = 1.0;
    if (sgn.z == 0.0) sgn.z = 1.0;
    uint oct = dirOctantFromSgn(sgn);

    vec3 boundsMax = vec3(o.gridSize);
    vec3 t0 = (vec3(0.0) - ro) * invDir;
    vec3 t1 = (boundsMax - ro) * invDir;
    vec3 tSmaller = min(t0, t1);
    vec3 tLarger = max(t0, t1);
    float tEnter = max(max(tSmaller.x, tSmaller.y), max(tSmaller.z, 0.0));
    float tExit = min(min(tLarger.x, tLarger.y), tLarger.z);
    if (tEnter > tExit) {
        return result;
    }

    vec3 pos = ro + rd * (tEnter + 1e-4);
    ivec3 mapPos = ivec3(clamp(floor(pos), vec3(0.0), boundsMax - vec3(1.0)));
    ivec3 startPos = mapPos;
    vec3 deltaDist = abs(invDir);
    vec3 sideDist = (sgn * (vec3(mapPos) - pos) + (sgn * 0.5 + 0.5)) * deltaDist;
    ivec3 rayStep = ivec3(sgn);
    bvec3 mask = bvec3(false);
    if (tSmaller.x > tSmaller.y && tSmaller.x > tSmaller.z) {
        mask = bvec3(true, false, false);
    } else if (tSmaller.y > tSmaller.z) {
        mask = bvec3(false, true, false);
    } else {
        mask = bvec3(false, false, true);
    }
    uint matId = readMaterial(o, mapPos);
    uint steps = 1u;
    if (matId != 0u) {
        vec3 hitLocalMeters = (ro + rd * tEnter) * o.voxelSize;
        vec3 hitWorld = (o.objectToWorld * vec4(hitLocalMeters, 1.0)).xyz;
        result.hit = true;
        result.tWorld = max(dot(hitWorld - Ow, Dw), 0.0);
        result.normal = normalize(mat3(o.objectToWorld) * (-vec3(mask) * sgn));
        result.steps = 1u;
        result.color = vec3(0.62, 0.64, 0.68);
        return result;
    }

    for (int i = 0; i < MAX_RAY_STEPS; ++i) {
        steps = uint(i + 1);
        if (any(lessThan(mapPos, ivec3(0))) || any(greaterThanEqual(uvec3(mapPos), o.gridSize))) {
            break;
        }

        matId = readMaterial(o, mapPos);
        if (matId != 0u) {
            float tCoarse = tEnter;
            if (mapPos != startPos) {
                vec3 mini = ((vec3(mapPos) - ro) + 0.5 - 0.5 * sgn) * invDir;
                tCoarse = max(mini.x, max(mini.y, mini.z));
            }
            vec3 hitLocalMeters = (ro + rd * tCoarse) * o.voxelSize;
            vec3 hitWorld = (o.objectToWorld * vec4(hitLocalMeters, 1.0)).xyz;
            result.hit = true;
            result.tWorld = dot(hitWorld - Ow, Dw);
            result.normal = normalize(mat3(o.objectToWorld) * (-vec3(mask) * sgn));
            result.steps = steps;
            result.color = vec3(0.62, 0.64, 0.68);
            return result;
        }

        int skipShift = coarseSkipShift(o, mapPos, oct);
        if (skipShift >= 0) {
            if (!jumpAlignedBox(mapPos, sideDist, mask, ro, rd, invDir, sgn, deltaDist, rayStep,
                                skipShift, boundsMax, steps)) {
                break;
            }
            continue;
        }

        mask = stepMask(sideDist);
        sideDist += vec3(mask) * deltaDist;
        mapPos += ivec3(vec3(mask)) * rayStep;
    }

    result.steps = steps;
    return result;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 dirView = normalize(vec3(ndc.x / ubo.projX, ndc.y / ubo.projY, -1.0));
    vec3 dir = normalize((ubo.invView * vec4(dirView, 0.0)).xyz);

    if (ubo.traceStage >= 4u) {
        imageStore(outImage, pixel, vec4(sampleSky(dir), 1.0));
        return;
    }

    vec3 color = vec3(0.0);
    float bestT = FLT_MAX;
    uint bestSteps = 0u;
    bool anyHit = false;
    vec3 hitN = vec3(0.0);
    vec3 hitAlbedo = vec3(0.0);

    for (uint i = 0u; i < ubo.objectCount; ++i) {
        Hit h = traceCoarse(objects[i], ubo.cameraPos, dir);
        bestSteps = max(bestSteps, h.steps);
        if (h.hit && h.tWorld < bestT) {
            bestT = h.tWorld;
            hitAlbedo = h.color;
            hitN = h.normal;
            anyHit = true;
        }
    }

    if (ubo.renderMode == MODE_STEPS) {
        float t = clamp(float(bestSteps) / float(MAX_RAY_STEPS), 0.0, 1.0);
        color = mix(vec3(0.05, 0.10, 0.35), vec3(1.0, 0.55, 0.10), t);
    } else if (anyHit) {
        if (ubo.solidColor != 0u) {
            color = ubo.solidRgb;
        } else if (ubo.renderMode == MODE_ALBEDO) {
            color = hitAlbedo;
        } else if (ubo.renderMode == MODE_NORMAL) {
            color = hitN * 0.5 + 0.5;
        } else {
#ifdef ENABLE_SHADE
            vec3 L = normalize(-ubo.lightDir);
            float ndotl = max(dot(hitN, L), 0.0);
            color = hitAlbedo * (ubo.ambient + (1.0 - ubo.ambient) * ndotl);
#else
            color = hitAlbedo;
#endif
        }
    } else {
        color = sampleSky(dir);
    }

    imageStore(outImage, pixel, vec4(color, 1.0));
}
