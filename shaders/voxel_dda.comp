#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform VoxelDdaUBO {
    mat4 invView;
    mat4 invProj;
    vec3 cameraPos;
    float voxelSize;
    vec3 lightDir;
    float ambient;
    vec3 gridOrigin;
    float projX;
    uvec3 gridSize;
    uint maxSteps;
    vec3 skyColor;
    uint renderMode;
    float projY;
    uint nestedMicro;
    float _pad2;
    float _pad3;
} ubo;

layout(set = 0, binding = 1, std430) readonly buffer VoxelGrid {
    uint voxels[];
};

layout(set = 0, binding = 2, rgba8) writeonly uniform image2D outImage;

// Per coarse cell: 16 uints = 512 occupancy bits for an editable 8^3 brick.
layout(set = 0, binding = 3, std430) readonly buffer MicroGrid {
    uint micro[];
};

const uint MODE_SHADED = 0u;
const uint MODE_ALBEDO = 1u;
const uint MODE_NORMAL = 2u;
const uint MODE_STEPS = 3u;
const uint MODE_COORD = 4u;
const uint MICRO_WORDS = 16u;
const float FLT_MAX = 3.4028235e+38;

uint voxelIndex(ivec3 p) {
    return uint(p.x) + uint(p.y) * ubo.gridSize.x + uint(p.z) * ubo.gridSize.x * ubo.gridSize.y;
}

bool insideGrid(ivec3 p) {
    return all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, ivec3(ubo.gridSize)));
}

uint readVoxel(ivec3 p) {
    return voxels[voxelIndex(p)];
}

bool getMicroVoxel(ivec3 coarse, ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(8)))) {
        return false;
    }
    uint bit = uint(c.y * 64 + c.z * 8 + c.x);
    uint base = voxelIndex(coarse) * MICRO_WORDS;
    uint word = micro[base + (bit >> 5)];
    return ((word >> (bit & 31u)) & 1u) != 0u;
}

vec3 albedoForVoxel(ivec3 p, uint matId) {
    float t = float(p.y) / max(float(ubo.gridSize.y - 1u), 1.0);
    vec3 cool = vec3(0.20, 0.55, 0.95);
    vec3 warm = vec3(0.95, 0.55, 0.20);
    vec3 base = mix(cool, warm, t);
    if (matId == 2u) {
        base = mix(base, vec3(0.35, 0.85, 0.45), 0.35);
    }
    return base;
}

vec3 stepsToColor(uint steps) {
    float t = clamp(float(steps) / float(max(ubo.maxSteps, 1u)), 0.0, 1.0);
    return mix(vec3(0.05, 0.10, 0.35), vec3(1.0, 0.55, 0.10), t);
}

bvec3 stepMask(vec3 sideDist) {
    return lessThanEqual(sideDist.xyz, min(sideDist.yzx, sideDist.zxy));
}

bool traceMicro(ivec3 coarse, vec3 localPos, vec3 rd, vec3 sgn, bvec3 enterMask,
                out ivec3 outMicro, out bvec3 outMask, inout uint outSteps) {
    localPos = clamp(localPos, vec3(0.0001), vec3(7.9999));
    ivec3 mapPos = ivec3(floor(localPos));
    vec3 deltaDist = abs(1.0 / rd);
    vec3 sideDist = (sgn * (vec3(mapPos) - localPos) + (sgn * 0.5 + 0.5)) * deltaDist;
    bvec3 mask = enterMask;
    ivec3 rayStep = ivec3(sgn);

    if (getMicroVoxel(coarse, mapPos)) {
        outMicro = mapPos;
        outMask = mask;
        return true;
    }

    for (int i = 0; i < 32; ++i) {
        outSteps += 1u;
        mask = stepMask(sideDist);
        sideDist += vec3(mask) * deltaDist;
        mapPos += ivec3(vec3(mask)) * rayStep;
        if (any(lessThan(mapPos, ivec3(0))) || any(greaterThanEqual(mapPos, ivec3(8)))) {
            return false;
        }
        if (getMicroVoxel(coarse, mapPos)) {
            outMicro = mapPos;
            outMask = mask;
            return true;
        }
    }
    return false;
}

bool traverse(vec3 originWorld, vec3 dirWorld, out vec3 outColor, out uint outSteps) {
    outSteps = 0u;
    outColor = ubo.skyColor;

    vec3 ro = (originWorld - ubo.gridOrigin) / ubo.voxelSize;
    vec3 rd = normalize(dirWorld);
    if (dot(rd, rd) < 1e-12) {
        return false;
    }

    vec3 invDir = clamp(1.0 / rd, vec3(-FLT_MAX), vec3(FLT_MAX));
    vec3 sgn = sign(rd);
    if (sgn.x == 0.0) sgn.x = 1.0;
    if (sgn.y == 0.0) sgn.y = 1.0;
    if (sgn.z == 0.0) sgn.z = 1.0;

    vec3 boundsMax = vec3(ubo.gridSize);
    vec3 t0 = (vec3(0.0) - ro) * invDir;
    vec3 t1 = (boundsMax - ro) * invDir;
    vec3 tSmaller = min(t0, t1);
    vec3 tLarger = max(t0, t1);
    float tEnter = max(max(tSmaller.x, tSmaller.y), max(tSmaller.z, 0.0));
    float tExit = min(min(tLarger.x, tLarger.y), tLarger.z);
    if (tEnter > tExit) {
        return false;
    }

    vec3 pos = ro + rd * (tEnter + 1e-4);
    ivec3 mapPos = ivec3(clamp(floor(pos), vec3(0.0), boundsMax - vec3(1.0)));
    ivec3 startPos = mapPos;

    vec3 deltaDist = abs(invDir);
    vec3 sideDist = (sgn * (vec3(mapPos) - pos) + (sgn * 0.5 + 0.5)) * deltaDist;
    ivec3 rayStep = ivec3(sgn);

    bvec3 mask = bvec3(false);
    if (tSmaller.x > tSmaller.y && tSmaller.x > tSmaller.z) {
        mask = bvec3(true, false, false);
    } else if (tSmaller.y > tSmaller.z) {
        mask = bvec3(false, true, false);
    } else {
        mask = bvec3(false, false, true);
    }

    bool hit = false;
    uint matId = 0u;
    ivec3 microPos = ivec3(0);
    bool usedMicro = false;

    for (uint i = 0u; i < ubo.maxSteps; ++i) {
        outSteps = i + 1u;
        if (!insideGrid(mapPos)) {
            break;
        }

        matId = readVoxel(mapPos);
        if (matId != 0u) {
            if (ubo.nestedMicro == 0u) {
                hit = true;
                break;
            }

            vec3 local01;
            if (mapPos == startPos) {
                local01 = clamp(pos - vec3(mapPos), vec3(0.0), vec3(0.9999));
            } else {
                vec3 mini = ((vec3(mapPos) - ro) + 0.5 - 0.5 * sgn) * invDir;
                float d = max(mini.x, max(mini.y, mini.z));
                vec3 intersect = ro + rd * d;
                local01 = clamp(intersect - vec3(mapPos), vec3(0.0), vec3(0.9999));
            }

            ivec3 hitMicro;
            bvec3 microMask;
            if (traceMicro(mapPos, local01 * 8.0, rd, sgn, mask, hitMicro, microMask, outSteps)) {
                hit = true;
                usedMicro = true;
                microPos = hitMicro;
                mask = microMask;
                break;
            }
        }

        mask = stepMask(sideDist);
        sideDist += vec3(mask) * deltaDist;
        mapPos += ivec3(vec3(mask)) * rayStep;
    }

    if (ubo.renderMode == MODE_STEPS) {
        outColor = stepsToColor(outSteps);
        return hit;
    }
    if (!hit) {
        outColor = ubo.skyColor;
        return false;
    }

    vec3 normal = -vec3(mask) * sgn;
    vec3 albedo = albedoForVoxel(mapPos, matId);
    if (usedMicro) {
        albedo = mix(albedo, vec3(microPos) / 7.0, 0.35);
    }

    if (ubo.renderMode == MODE_ALBEDO) {
        outColor = usedMicro ? (vec3(microPos) / 7.0) : albedo;
    } else if (ubo.renderMode == MODE_NORMAL) {
        outColor = normal * 0.5 + 0.5;
    } else if (ubo.renderMode == MODE_COORD) {
        outColor = usedMicro ? (vec3(microPos) / 7.0)
                             : (vec3(mapPos) / max(vec3(ubo.gridSize - uvec3(1u)), vec3(1.0)));
    } else {
        vec3 L = normalize(-ubo.lightDir);
        float ndotl = max(dot(normal, L), 0.0);
        outColor = albedo * (ubo.ambient + (1.0 - ubo.ambient) * ndotl);
    }
    return true;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 dirView = normalize(vec3(ndc.x / ubo.projX, ndc.y / ubo.projY, -1.0));
    vec3 dir = normalize((ubo.invView * vec4(dirView, 0.0)).xyz);

    vec3 color;
    uint steps = 0u;
    bool hit = traverse(ubo.cameraPos, dir, color, steps);
    if (!hit && ubo.renderMode != MODE_STEPS) {
        color = ubo.skyColor;
    }
    imageStore(outImage, pixel, vec4(color, 1.0));
}
